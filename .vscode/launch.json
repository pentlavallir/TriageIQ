{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TriageIQ - App (F5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "TriageIQ - Uvicorn (no reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "127.0.0.1", "--port", "8080"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "TriageIQ - Build knowledge base",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/data_ingestion.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "TriageIQ - Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
